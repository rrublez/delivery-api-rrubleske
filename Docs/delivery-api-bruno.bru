meta {
  name: Delivery API - Testes Manuais
  type: http
  seq: 1
}

var baseUrl = http://localhost:8080

// ============================================
// 0 - SETUP E VALIDAÇÃO
// ============================================

@name("0.1 - Health Check")
GET {{baseUrl}}/health

// ============================================
// 1 - TESTES DE VALIDAÇÃO
// ============================================

@name("1.1 - ❌ Cliente - Email Inválido")
POST {{baseUrl}}/api/clientes
Content-Type: application/json

{
  "nome": "Teste Validação",
  "email": "email-invalido",
  "telefone": "11987654321",
  "cpf": "12345678901",
  "ativo": true
}

@name("1.2 - ❌ Cliente - CPF Inválido")
POST {{baseUrl}}/api/clientes
Content-Type: application/json

{
  "nome": "Teste Validação",
  "email": "cpfinvalido@email.com",
  "telefone": "11987654321",
  "cpf": "00000000000",
  "ativo": true
}

