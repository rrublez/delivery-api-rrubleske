// ============================================
// 3 - CONSULTAS SIMPLES
// ============================================

@name("3.1 - 🔍 Buscar Cliente por Email")
GET {{baseUrl}}/api/clientes/email/joao@email.com

@name("3.2 - 🔍 Buscar Produtos por Categoria (Pizzas)")
GET {{baseUrl}}/api/produtos/categoria/Pizzas

@name("3.3 - 🔍 Listar Restaurantes por Ramo (Pizzaria)")
GET {{baseUrl}}/api/restaurantes/ramo/Pizzaria

@name("3.4 - 🔍 Listar Pedidos por Status (ENTREGUE)")
GET {{baseUrl}}/api/pedidos/status/ENTREGUE

@name("3.5 - 🔍 Listar Pedidos por Cliente (ID 1)")
GET {{baseUrl}}/api/pedidos/cliente/1

@name("3.6 - 🔍 Produtos Disponíveis")
GET {{baseUrl}}/api/produtos/disponivel

@name("3.7 - 🔍 Restaurantes Ativos")
GET {{baseUrl}}/api/restaurantes/ativo

// ============================================
// 4 - RELATÓRIOS E ENDPOINTS COMPLEXOS
// ============================================

@name("4.1 - 📊 Total de Vendas por Restaurante")
GET {{baseUrl}}/api/pedidos/relatorio/vendas-por-restaurante

@name("4.2 - 📊 Pedidos com Valor Acima de 100")
GET {{baseUrl}}/api/pedidos/relatorio/valor-acima?valor=100

@name("4.3 - 📊 Pedidos com Valor Acima de 50")
GET {{baseUrl}}/api/pedidos/relatorio/valor-acima?valor=50

@name("4.4 - 📊 Relatório por Período e Status (ENTREGUE)")
GET {{baseUrl}}/api/pedidos/relatorio/periodo-status
  ?dataInicial=2025-01-01T00:00:00
  &dataFinal=2025-12-31T23:59:59
  &status=ENTREGUE

@name("4.5 - 📊 Relatório por Período e Status (PENDENTE)")
GET {{baseUrl}}/api/pedidos/relatorio/periodo-status
  ?dataInicial=2025-01-01T00:00:00
  &dataFinal=2025-12-31T23:59:59
  &status=PENDENTE

@name("4.6 - 📊 Produtos Mais Vendidos")
GET {{baseUrl}}/api/produtos/relatorio/mais-vendidos

@name("4.7 - 📊 Ranking de Clientes por Número de Pedidos")
GET {{baseUrl}}/api/clientes/relatorio/ranking-por-pedidos

@name("4.8 - 📊 Faturamento por Categoria")
GET {{baseUrl}}/api/produtos/relatorio/faturamento-por-categoria
