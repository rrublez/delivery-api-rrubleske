  "notes": {
    "setup": [
      "1. Importe esta coleção no Postman ou Thunder Client",
      "2. Configure as variáveis de ambiente (baseUrl, clienteId, restauranteId, etc)",
      "3. Execute a sequência recomendada: Restaurantes → Clientes → Produtos → Pedidos → Relatórios",
      "4. Use os IDs retornados nas respostas para popular os valores das variáveis"
    ],
    "testingStrategy": [
      "SUCCESS PATH: Crie um restaurante, depois cliente, depois produtos, depois pedido",
      "VALIDATION ERRORS: Teste criar com campos obrigatórios vazios",
      "NOT FOUND: Teste buscar IDs inexistentes (ex: /clientes/9999)",
      "CONFLICT: Teste criar cliente com email duplicado ou restaurante com CNPJ duplicado",
      "INTERNAL SERVER ERROR: Simule com dados malformados"
    ],
    "httpCodes": {
      "200": "OK - Requisição bem-sucedida com retorno de dados",
      "201": "Created - Recurso criado com sucesso",
      "204": "No Content - Operação bem-sucedida sem conteúdo de retorno",
      "400": "Bad Request - Erro na validação ou dados malformados",
      "404": "Not Found - Recurso não encontrado",
      "409": "Conflict - Conflito de dados (email/CNPJ duplicado)",
      "500": "Internal Server Error - Erro no servidor"
    }
  }
}
